{
  "name": "spades",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @spades/rules -w @cardroom/palace -w @cardroom/games -w @cardroom/decks -w @spades/rooms -w @spades/server -w @spades/web -w @cardroom/designer -w @cardroom/admin",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p .railway/tsconfig.json",
    "start": "npm start -w @spades/server",
    "dev": "npm run build -w @spades/rules -w @cardroom/palace -w @cardroom/games -w @cardroom/decks -w @spades/rooms && (npm run dev -w @spades/server & npm run dev -w @spades/web)"
  },
  "devDependencies": {
    "railway": "^3.17.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
