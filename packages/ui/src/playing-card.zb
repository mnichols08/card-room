<!--
  One playing card: a pip card, a joker, or the back of a card. Tap a playable card to pick it.
  `card` is `{ kind: "pip", suit, rank }` (rank 2–14) or `{ kind: "joker", size: "big" | "little" }`.
  Sizes come from the page: --card-w / --card-h for the hand, --trick-w / --trick-h for size="table".
  Everything inside scales with the card itself (container units), so one design serves every size.
  A deck's look comes from the page too: the --deck-* variables (`deckVars` in @cardroom/decks) set
  the back's pattern, frame and emblem, the paper, each suit's ink, the lettering and the corners.
  Without them it's the card room's own deck.
  @fires pick - A playable card was tapped.
-->
<script>
  import { emit } from '@zubra/runtime'

  // U+FE0E asks for the text glyph, so phones don't draw ♥ and ♦ as emoji (which ignore colour).
  const SYMBOLS = { spades: "♠︎", hearts: "♥︎", diamonds: "♦︎", clubs: "♣︎" }
  const RANKS = { 11: "J", 12: "Q", 13: "K", 14: "A" }
  // Classic pip spots: x%, y%, and 1 when the pip is upside down (the bottom half of the card).
  const PIPS = {
    2: [[50, 20], [50, 80, 1]],
    3: [[50, 20], [50, 50], [50, 80, 1]],
    4: [[35, 20], [65, 20], [35, 80, 1], [65, 80, 1]],
    5: [[35, 20], [65, 20], [50, 50], [35, 80, 1], [65, 80, 1]],
    6: [[35, 20], [65, 20], [35, 50], [65, 50], [35, 80, 1], [65, 80, 1]],
    7: [[35, 20], [65, 20], [50, 35], [35, 50], [65, 50], [35, 80, 1], [65, 80, 1]],
    8: [[35, 20], [65, 20], [50, 35], [35, 50], [65, 50], [50, 65, 1], [35, 80, 1], [65, 80, 1]],
    9: [[35, 20], [65, 20], [35, 40], [65, 40], [50, 50], [35, 60, 1], [65, 60, 1], [35, 80, 1], [65, 80, 1]],
    10: [[35, 20], [65, 20], [50, 30], [35, 40], [65, 40], [35, 60, 1], [65, 60, 1], [50, 70, 1], [35, 80, 1], [65, 80, 1]],
  }

  const joker = card.kind === "joker"
  const red = joker ? card.size === "big" : card.suit === "hearts" || card.suit === "diamonds"
  const rank = joker ? "★" : RANKS[card.rank] ?? String(card.rank)
  const symbol = joker ? "" : SYMBOLS[card.suit]
  const name = joker ? (card.size === "big" ? "Big Joker" : "Little Joker") : `${rank} of ${card.suit}`
  const court = !joker && card.rank >= 11 && card.rank <= 13
  const ace = !joker && card.rank === 14
  const kind = joker ? "joker" : court ? "court" : ace ? "ace" : "pips"
  const pips = kind === "pips" ? PIPS[card.rank].map(([x, y, f], i) => ({ id: i, x: `${x}%`, y: `${y}%`, flip: !!f })) : []
  const ten = rank === "10"
  const spadeAce = ace && card.suit === "spades"
  const jokerWord = joker ? (card.size === "big" ? "BIG" : "LIL") : ""
  const king = court && card.rank === 13
  const queen = court && card.rank === 12
  const jack = court && card.rank === 11
  // Cards share one document, so each portrait's half needs its own id for <use> to find.
  globalThis.__courtIds = (globalThis.__courtIds ?? 0) + 1
  const halfId = `court-half-${globalThis.__courtIds}`
  const halfRef = `#${halfId}`
</script>
<style>
  :host { display: inline-block; flex: none; }
  .card {
    --ink-black: var(--deck-black, #1d1a16);
    --ink-red: var(--deck-red, #b3261e);
    position: relative;
    display: block;
    width: var(--card-w, 56px);
    height: var(--card-h, 80px);
    padding: 0;
    overflow: hidden;
    container-type: inline-size;
    border-radius: calc(var(--card-w, 56px) * var(--deck-corner, 0.1));
    border: 1px solid rgba(40, 30, 15, 0.16);
    background: var(--deck-paper-image, linear-gradient(170deg, #fffefb 0%, #fbf7ee 60%, #f3ede0 100%));
    color: var(--ink-black);
    font: inherit;
    text-align: left;
    box-shadow: var(--elev-1, 0 1px 1px rgba(0, 0, 0, 0.2), 0 2px 5px rgba(0, 0, 0, 0.22)), inset 0 0 0 1px rgba(255, 255, 255, 0.7);
    transition:
      transform var(--dur-1, 120ms) var(--ease-out, ease-out),
      box-shadow var(--dur-1, 120ms) var(--ease-out, ease-out),
      filter var(--dur-1, 120ms);
  }
  .card[data-size=table] { width: var(--trick-w, 52px); height: var(--trick-h, 74px); border-radius: calc(var(--trick-w, 52px) * var(--deck-corner, 0.1)); }
  /* Mini: the cards in front of the other players. */
  .card[data-size=mini] { width: var(--mini-w, 34px); height: var(--mini-h, 48px); border-radius: calc(var(--mini-w, 34px) * var(--deck-corner, 0.1)); }
  .card.red { color: var(--ink-red); }
  /* A four-colour deck gives clubs and diamonds inks of their own. */
  .card.clubs { color: var(--deck-clubs, var(--ink-black)); }
  .card.diamonds { color: var(--deck-diamonds, var(--ink-red)); }
  .glyph { font-family: "Apple Symbols", "Segoe UI Symbol", "Noto Sans Symbols 2", system-ui, sans-serif; font-style: normal; font-variant-emoji: text; line-height: 1; }

  /* The corner index: what shows in an overlapped hand, so it's big. */
  .index { position: absolute; display: flex; flex-direction: column; align-items: center; line-height: 0.9; }
  .index.tl { top: 5cqw; left: 6cqw; }
  .index b { font: 800 30cqw/0.9 var(--deck-font, system-ui, -apple-system, "Segoe UI", sans-serif); letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .index b.ten { letter-spacing: -0.12em; margin-left: -0.08em; }
  .index i { font-size: 24cqw; margin-top: 1cqw; }
  .index.br { bottom: 5cqw; right: 6cqw; rotate: 180deg; display: none; }
  .card[data-size=table] .index.br { display: flex; }

  /* The middle of the card. Small cards: one big symbol clear of the index. */
  .face { position: absolute; inset: 0; pointer-events: none; }
  .face .big { position: absolute; left: 60%; top: 62%; translate: -50% -50%; font-size: 44cqw; }
  /* Court cards: a double-ended portrait, clear of the corner index (top left; bottom right too on bigger cards). */
  .face .royal { position: absolute; top: 6cqw; bottom: 6cqw; left: 37cqw; right: 5cqw; width: auto; height: auto; }
  .face .pip { display: none; position: absolute; translate: -50% -50%; font-size: 17cqw; }
  .face .pip.flip { rotate: 180deg; }
  .face .ring, .face .jword { display: none; }
  .face.ace .big { left: 50%; top: 52%; font-size: 56cqw; }
  .face.joker .big { left: 55%; top: 60%; font-size: 46cqw; }
  .face.joker .big::before { content: "★"; }
  .index .jsize { font: 800 12cqw/1 system-ui, sans-serif; margin-top: 2cqw; letter-spacing: 0.04em; }

  /* Bigger cards (tablet, desktop, and every card on the table): the classic layouts. */
  @container (min-width: 84px) {
    .index.br { display: flex; }
    .index b { font-size: 24cqw; }
    .index i { font-size: 18cqw; }
    .face.pips { inset: 14cqw 10cqw; }
    .face.pips .big { display: none; }
    .face.pips .pip { display: block; }
    .face .royal { left: 26cqw; right: 26cqw; top: 7cqw; bottom: 7cqw; }
    .face.joker .big { left: 46%; top: 50%; }
    .face.joker .jword {
      display: block; position: absolute; right: 7cqw; top: 50%; translate: 0 -50%;
      writing-mode: vertical-rl; font: 800 11cqw/1 system-ui, sans-serif; letter-spacing: 0.2em;
    }
  }
  .card[data-size=table] .face .royal { left: 26cqw; right: 26cqw; top: 7cqw; bottom: 7cqw; }
  .card[data-size=table] .face.pips { inset: 14cqw 10cqw; }
  .card[data-size=table] .face.pips .big { display: none; }
  .card[data-size=table] .face.pips .pip { display: block; }
  .face.ace .ring { display: block; position: absolute; left: 50%; top: 52%; width: 66cqw; height: 66cqw; translate: -50% -50%; border-radius: 50%; box-shadow: 0 0 0 2cqw #fffdf8, 0 0 0 3cqw currentColor; opacity: 0.6; }

  /* States. Playable cards look normal; the ones you can't play sink and grey a little, but stay readable. */
  .card.playable { cursor: pointer; }
  @media (hover: hover) {
    .card.playable:not(.dim):hover { transform: translateY(calc(var(--card-h, 80px) * -0.1)); box-shadow: var(--elev-2, 0 10px 18px rgba(0, 0, 0, 0.3)); }
  }
  .card.dim { cursor: default; transform: translateY(calc(var(--card-h, 80px) * 0.06)); filter: saturate(0.55) brightness(0.82); }
  .card.selected {
    transform: translateY(calc(var(--card-h, 80px) * -0.18));
    box-shadow: 0 0 0 3px #e8c46a, var(--elev-2, 0 10px 18px rgba(0, 0, 0, 0.3));
    transition-timing-function: var(--ease-back, ease-out);
  }
  .card.won { box-shadow: 0 0 0 3px #e8c46a, 0 0 18px 2px rgba(232, 196, 106, 0.55), var(--elev-3, 0 18px 36px rgba(0, 0, 0, 0.38)); }
  .card:focus-visible { outline: 3px solid #ffd76a; outline-offset: 2px; transform: translateY(calc(var(--card-h, 80px) * -0.1)); }
  .card.shake { animation: card-shake 220ms linear; }
  @keyframes card-shake { 25% { translate: -4px 0; } 50% { translate: 4px 0; } 75% { translate: -3px 0; } }

  /* The back: burgundy lattice, cream border with a gold hairline, a gold medallion with a spade;
     or whatever the deck's design says. The back is a container, so its pattern (drawn on ::before)
     is measured in hundredths of the card's width (cqw) at every size. */
  .back {
    position: relative;
    width: var(--card-w, 56px);
    height: var(--card-h, 80px);
    overflow: hidden;
    container-type: inline-size;
    border-radius: calc(var(--card-w, 56px) * var(--deck-corner, 0.1));
    box-shadow: var(--elev-1, 0 2px 5px rgba(0, 0, 0, 0.3));
  }
  .back[data-size=table] { width: var(--trick-w, 52px); height: var(--trick-h, 74px); border-radius: calc(var(--trick-w, 52px) * var(--deck-corner, 0.1)); }
  .back[data-size=mini] { width: var(--mini-w, 34px); height: var(--mini-h, 48px); border-radius: calc(var(--mini-w, 34px) * var(--deck-corner, 0.1)); }
  .back::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background: var(--deck-back-image,
      radial-gradient(circle at 50% 50%, #e8c46a 0 9cqw, transparent 9.5cqw),
      radial-gradient(circle at 50% 50%, #7a1f2b 0 13cqw, transparent 13.5cqw),
      repeating-linear-gradient(45deg, rgba(232, 196, 106, 0.22) 0 1px, transparent 1px 7cqw),
      repeating-linear-gradient(-45deg, rgba(232, 196, 106, 0.22) 0 1px, transparent 1px 7cqw),
      linear-gradient(160deg, #8e2a36, #6a1a25));
    box-shadow: var(--deck-back-frame, inset 0 0 0 4cqw #fffdf8, inset 0 0 0 5cqw rgba(232, 196, 106, 0.7));
  }
  .back::after {
    content: var(--deck-emblem, "♠\FE0E"); position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 12cqw; line-height: 1; color: var(--deck-emblem-ink, #7a1f2b); font-variant-emoji: text;
  }

  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card.shake { animation: none; } }
</style>
<playing-card card={{ kind: "pip", suit: "spades", rank: 14 }} size="hand" back={false} playable={false} dim={false} selected={false} won={false} shake={false}>
  <div zb-if={back} class="back" data-size={size} aria-hidden="true"></div>
  <button
    zb-else
    type="button"
    class="card"
    data-size={size}
    class:red={red}
    class:diamonds={!joker && card.suit === "diamonds"}
    class:clubs={!joker && card.suit === "clubs"}
    class:playable={playable}
    class:dim={dim}
    class:selected={selected}
    class:won={won}
    class:shake={shake}
    disabled={!playable || dim}
    aria-label={name}
    aria-pressed={selected ? "true" : null}
    onclick={() => emit('pick')}
  >
    <span class="index tl" aria-hidden="true">
      <b class:ten={ten}>{rank}</b>
      <i zb-if={!joker} class="glyph">{symbol}</i>
      <span zb-else class="jsize">{jokerWord}</span>
    </span>
    <span class="index br" aria-hidden="true">
      <b class:ten={ten}>{rank}</b>
      <i zb-if={!joker} class="glyph">{symbol}</i>
    </span>
    <span class="face" class:pips={kind === "pips"} class:court={court} class:ace={ace} class:joker={joker} aria-hidden="true">
      <svg zb-if={court} class="royal" viewBox="0 0 100 200" preserveAspectRatio="xMidYMid meet">
        <defs>
          <g id={halfId}>
            <path d="M12 100 L16 77 Q20 65 36 61 L64 61 Q80 65 84 77 L88 100 Z" fill="currentColor" />
            <path d="M16 77 Q20 65 36 61 M84 77 Q80 65 64 61" fill="none" stroke="#c9a227" stroke-width="1.6" />
            <path d="M34 61 L50 81 L66 61 L60 61 L50 73 L40 61 Z" fill="#c9a227" stroke="#7a5a10" stroke-width="0.6" />
            <path d="M40 61 L50 73 L60 61 Z" fill="#2c4a8a" />
            <text x="50" y="91" text-anchor="middle" font-size="12" fill="#fffdf8" class="glyph">{symbol}</text>
            <rect x="13" y="93.5" width="74" height="6.5" fill="#fffdf8" stroke="#c9a227" stroke-width="0.7" />
            <path d="M22 95.5 v3 M34 95.5 v3 M46 95.5 v3 M58 95.5 v3 M70 95.5 v3 M82 95.5 v3" stroke="#1d1a16" stroke-width="1.4" />
            <g zb-if={queen}>
              <path d="M35 50 Q33 30 50 30 Q67 30 65 50 L68 66 Q60 60 60 50 Q58 39 50 39 Q42 39 40 50 Q40 60 32 66 Z" fill="#6b3a1f" />
            </g>
            <circle cx="50" cy="47" r="12" fill="#f4dcc2" stroke="#3b2a1a" stroke-width="0.7" />
            <circle cx="45.5" cy="46" r="1.2" fill="#2b1d12" />
            <circle cx="54.5" cy="46" r="1.2" fill="#2b1d12" />
            <path d="M46 53 Q50 55.5 54 53" fill="none" stroke="#9b3b2b" stroke-width="1" stroke-linecap="round" />
            <g zb-if={king}>
              <path d="M38.5 49 Q38 66 50 70 Q62 66 61.5 49 Q58 57 50 57.5 Q42 57 38.5 49 Z" fill="#6b4a2b" />
              <path d="M44 52.5 Q50 50 56 52.5 Q50 54 44 52.5 Z" fill="#6b4a2b" />
              <path d="M36 35 L36 18 L43 26 L50 12 L57 26 L64 18 L64 35 Z" fill="#d9b23a" stroke="#7a5a10" stroke-width="0.8" stroke-linejoin="round" />
              <rect x="36" y="31" width="28" height="5" fill="#b8901f" stroke="#7a5a10" stroke-width="0.6" />
              <circle cx="43" cy="33.5" r="1.5" fill="#b3261e" />
              <circle cx="50" cy="33.5" r="1.5" fill="#2c4a8a" />
              <circle cx="57" cy="33.5" r="1.5" fill="#b3261e" />
              <circle cx="50" cy="11" r="2.2" fill="#d9b23a" stroke="#7a5a10" stroke-width="0.6" />
              <line x1="20" y1="38" x2="20" y2="98" stroke="#b8b8c0" stroke-width="2.6" />
              <line x1="13" y1="52" x2="27" y2="52" stroke="#c9a227" stroke-width="3" stroke-linecap="round" />
              <circle cx="20" cy="56" r="2" fill="#c9a227" />
            </g>
            <g zb-if={queen}>
              <path d="M37 37 Q50 18 63 37 Q50 31 37 37 Z" fill="#d9b23a" stroke="#7a5a10" stroke-width="0.8" />
              <circle cx="43" cy="29" r="1.8" fill="#fffdf8" stroke="#a89060" stroke-width="0.4" />
              <circle cx="50" cy="25.5" r="2.2" fill="#b3261e" />
              <circle cx="57" cy="29" r="1.8" fill="#fffdf8" stroke="#a89060" stroke-width="0.4" />
              <line x1="21" y1="52" x2="21" y2="98" stroke="#3d7a3d" stroke-width="1.8" />
              <path d="M21 70 Q14 66 13 60 Q19 62 21 68 Z" fill="#3d7a3d" />
              <circle cx="21" cy="47" r="5" fill="#c0392b" />
              <circle cx="21" cy="47" r="2" fill="#e8c46a" />
            </g>
            <g zb-if={jack}>
              <path d="M37.5 49 Q36 34 50 34 Q64 34 62.5 49 L63 56 Q60 45 50 43 Q40 45 37 56 Z" fill="#8a5a2b" />
              <path d="M35 38 Q37 23 52 24 Q65 25 65 38 Z" fill="#2c4a8a" stroke="#1a2c55" stroke-width="0.8" />
              <rect x="35" y="35" width="30" height="4" fill="#c9a227" />
              <path d="M61 27 Q76 8 88 13 Q76 16 64 31 Z" fill="currentColor" />
              <line x1="80" y1="34" x2="80" y2="98" stroke="#7a5a3a" stroke-width="2.2" />
              <path d="M80 30 L90 37 L80 43 Z" fill="#b8b8c0" stroke="#6a6a72" stroke-width="0.6" />
            </g>
          </g>
        </defs>
        <rect x="2" y="2" width="96" height="196" rx="7" fill="#fbf3df" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.55" />
        <rect x="6" y="6" width="88" height="188" rx="5" fill="none" stroke="#c9a227" stroke-width="1" />
        <use href={halfRef} />
        <use href={halfRef} transform="rotate(180 50 100)" />
        <line x1="8" y1="100" x2="92" y2="100" stroke="#c9a227" stroke-width="1.2" />
      </svg>
      <span zb-if={spadeAce} class="ring"></span>
      <span zb-if={!court} class="big glyph">{symbol}</span>
      <zb-each items={pips} as="p" key={p.id}>
        <span class="pip glyph" class:flip={p.flip} style={{ left: p.x, top: p.y }}>{symbol}</span>
      </zb-each>
      <span zb-if={joker} class="jword">JOKER</span>
    </span>
  </button>
</playing-card>
