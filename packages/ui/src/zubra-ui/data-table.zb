<!-- Copied from zubra-ui (ba5737e) components/data-table.zb: https://github.com/journey-to-code-org/zubra-ui. Ours to edit. -->
<!--
  A table of records you can sort, filter and select from. Click a column's heading to sort by
  it (again to reverse; announced with `aria-sort`), type in the box to filter every column, and
  with `selectable` tick rows (the heading's box selects every shown row). `columns` is
  `[{ key, label, sortable?, align?, format? }]` (`format`: "number", "currency", "date"); `rows` is
  an array of objects with an `id`. `selected` (an array of ids) is two-way. Long tables page by
  `pageSize`.
  @fires selectedchange - The selection changed; `detail` is the array of selected ids.
  @fires sortchange - The sort changed; `detail` is `{ key, direction }`.
-->
<script>
  import { effect, emit } from '@zubra/runtime'

  let all = null

  let sortKey = ""
  let direction = "ascending"
  let query = ""
  let pageIndex = 0

  // A function given what it reads, so the derived rows follow every one of them.
  function arrange(list, cols, text, key, order) {
    const words = text.toLowerCase().split(/\s+/).filter(Boolean)
    const filtered = list.filter((row) => words.every((word) => cols.some((column) => String(row[column.key] ?? "").toLowerCase().includes(word))))
    if (!key) return filtered
    const sign = order === "ascending" ? 1 : -1
    return [...filtered].sort((a, b) => {
      const x = a[key]
      const y = b[key]
      return (typeof x === "number" && typeof y === "number" ? x - y : String(x ?? "").localeCompare(String(y ?? ""), undefined, { numeric: true })) * sign
    })
  }
  const shown = arrange(rows, columns, query, sortKey, direction)
  const pageCount = pageSize > 0 ? Math.max(1, Math.ceil(shown.length / pageSize)) : 1
  const page = Math.min(pageIndex, pageCount - 1)
  const visible = pageSize > 0 ? shown.slice(page * pageSize, page * pageSize + pageSize) : shown
  const allSelected = visible.length > 0 && visible.every((row) => selected.includes(row.id))
  const someSelected = !allSelected && visible.some((row) => selected.includes(row.id))

  const cell = (row, column) => {
    const value = row[column.key]
    if (value == null) return ""
    if (column.format === "number" && typeof value === "number") return value.toLocaleString()
    if (column.format === "currency" && typeof value === "number") return value.toLocaleString(undefined, { style: "currency", currency })
    if (column.format === "date") { const date = new Date(value); return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleDateString() }
    return String(value)
  }
  // `indeterminate` is a property of the input, never an attribute.
  effect(() => {
    if (all) all.indeterminate = someSelected
  })
  function sort(column) {
    if (!column.sortable) return
    direction = sortKey === column.key && direction === "ascending" ? "descending" : "ascending"
    sortKey = column.key
    emit('sortchange', { key: sortKey, direction })
  }
  function toggle(row) {
    selected = selected.includes(row.id) ? selected.filter((id) => id !== row.id) : [...selected, row.id]
  }
  function toggleAll() {
    const ids = visible.map((row) => row.id)
    selected = allSelected ? selected.filter((id) => !ids.includes(id)) : [...new Set([...selected, ...ids])]
  }
  function filter(event) {
    query = event.target.value
    pageIndex = 0
  }
</script>
<style>
  :host { display: block; }
  .table-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.75rem; }
  .table-filter { width: min(18rem, 100%); padding: 0.5rem 0.75rem; border: 1px solid var(--input, #e4e4e7); border-radius: calc(var(--radius, 0.625rem) * 0.8); background: var(--background, #fff); color: var(--foreground, #18181b); font: inherit; font-size: 0.9rem; }
  .table-filter:focus-visible { outline: none; border-color: var(--ring, #a1a1aa); box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring, #a1a1aa) 40%, transparent); }
  .table-count { font-size: 0.85rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .table-scroll { overflow-x: auto; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border, #e4e4e7); text-align: left; white-space: nowrap; }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-weight: 600; background: color-mix(in oklab, var(--muted, #f4f4f5) 55%, var(--background, #fff)); }
  .table-end { text-align: right; font-variant-numeric: tabular-nums; }
  .table-check { width: 2.5rem; }
  tbody tr:hover { background: color-mix(in oklab, var(--muted, #f4f4f5) 45%, transparent); }
  tbody tr.table-selected { background: color-mix(in oklab, var(--primary, #18181b) 7%, var(--background, #fff)); }
  .table-sort { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-weight: 600; cursor: pointer; }
  .table-sort::after { content: "↕"; font-size: 0.75em; opacity: 0.45; }
  [aria-sort=ascending] .table-sort::after { content: "↑"; opacity: 1; }
  [aria-sort=descending] .table-sort::after { content: "↓"; opacity: 1; }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 2px; }
  input[type=checkbox] { width: 1rem; height: 1rem; accent-color: var(--primary, #18181b); cursor: pointer; }
  .table-empty { padding: 2rem 1rem; text-align: center; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .table-pages { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem; font-size: 0.85rem; }
  .table-pages button { height: 2rem; padding: 0 0.75rem; border: 1px solid var(--border, #e4e4e7); border-radius: calc(var(--radius, 0.625rem) * 0.7); background: var(--background, #fff); color: var(--foreground, #18181b); font: inherit; cursor: pointer; }
  .table-pages button:disabled { opacity: 0.45; cursor: not-allowed; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<data-table columns={[]} rows={[]} selected:model={[]} selectable={false} filterable={true} page-size={0} currency="USD" label="Records">
  <div class="table-tools">
    <input zb-if={filterable} class="table-filter" type="search" placeholder="Filter…" aria-label={`Filter ${label}`} value={query} oninput={filter}>
    <span class="table-count" role="status">{selectable && selected.length ? `${selected.length} selected · ` : ""}{shown.length} {shown.length === 1 ? "row" : "rows"}</span>
  </div>
  <div class="table-scroll" role="region" aria-label={label} tabindex="0">
    <table aria-label={label}>
      <thead>
        <tr>
          <th zb-if={selectable} class="table-check" scope="col"><input ref={all} type="checkbox" aria-label="Select all shown rows" checked={allSelected} onchange={toggleAll}></th>
          <zb-each items={columns} as="column" key={column.key}>
            <th scope="col" class:table-end={column.align === "end" || column.format === "number" || column.format === "currency"} aria-sort={sortKey === column.key ? direction : null}>
              <button zb-if={column.sortable} type="button" class="table-sort" onclick={() => sort(column)}>{column.label}</button>
              <span zb-else>{column.label}</span>
            </th>
          </zb-each>
        </tr>
      </thead>
      <tbody>
        <zb-each items={visible} as="row" key={row.id}>
          <tr class:table-selected={selectable && selected.includes(row.id)}>
            <td zb-if={selectable} class="table-check"><input type="checkbox" aria-label={`Select ${row[columns[0]?.key] ?? row.id}`} checked={selected.includes(row.id)} onchange={() => toggle(row)}></td>
            <zb-each items={columns} as="column" key={column.key}>
              <td class:table-end={column.align === "end" || column.format === "number" || column.format === "currency"}>{cell(row, column)}</td>
            </zb-each>
          </tr>
        </zb-each>
        <tr zb-if={!visible.length}><td class="table-empty" colspan={columns.length + (selectable ? 1 : 0)}>{query ? `Nothing matches "${query}".` : "No records yet."}</td></tr>
      </tbody>
    </table>
  </div>
  <div zb-if={pageCount > 1} class="table-pages">
    <button type="button" disabled={page === 0} onclick={() => (pageIndex = page - 1)}>Previous</button>
    <span>Page {page + 1} of {pageCount}</span>
    <button type="button" disabled={page >= pageCount - 1} onclick={() => (pageIndex = page + 1)}>Next</button>
  </div>
</data-table>
