<!--
  The card room on any page: a blog post, a WordPress site, plain HTML. Shows a game (Palace, Spades,
  or both) with a button to play right there against the computer, a button to challenge the site's
  owner, and a link into the card room for family tables.

  A practice game runs inside the page in a frame. Challenges and family tables open the card room in
  a new tab, because browsers don't let a game in a frame on someone else's site keep you signed in.

  `server` is the card room's address (required). `game` is "palace", "spades" or "" for both.
  `challenge` is a challenge link's code; `who` is the name to show on that button.
-->
<script>
  const GAMES = {
    palace: { name: "Palace", emoji: "🏰", blurb: "Shed every card first. Don't get stuck holding the pile." },
    spades: { name: "Spades", emoji: "♠\uFE0E", blurb: "Partners, bids and nils, with computer partners who talk back." },
  }
  // No regular expressions here: Zubra's render ahead (open.blog's build) can't evaluate them yet.
  const trimmed = String(server || "").trim()
  const base = trimmed.endsWith("/") ? trimmed.slice(0, -1) : trimmed
  const offered = game && GAMES[game] ? [game] : ["spades", "palace"]
  let picked = offered[0]
  let playing = false
  const info = () => GAMES[picked]
  // Rendered ahead too, so plain string work only: the values are fixed words and a link code.
  const url = (params) => `${base}/?${Object.keys(params).map((k) => `${k}=${params[k]}`).join("&")}`
  const frameSrc = () => url({ embed: "1", game: picked })
  const openTab = (params) => {
    const query = Object.keys(params).map((k) => `${k}=${encodeURIComponent(params[k])}`).join("&")
    window.open(`${base}/?${query}`, "_blank", "noopener")
  }
</script>
<style>
  :host { display: block; max-width: 520px; margin: 1.5rem auto; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
  .box { border-radius: 16px; overflow: hidden; background: #1f4d3a; color: #fbf6ec; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); }
  .card { padding: 18px 18px 16px; display: grid; gap: 12px; }
  h3 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.5rem; display: flex; align-items: center; gap: 8px; }
  p { margin: 0; color: #cfe2d6; line-height: 1.4; }
  .tabs { display: flex; gap: 6px; }
  .tabs button { flex: 1; padding: 8px; border-radius: 10px; border: 2px solid rgba(255, 255, 255, 0.15); background: rgba(0, 0, 0, 0.2); color: inherit; font: inherit; font-weight: 700; cursor: pointer; }
  .tabs button[aria-pressed=true] { border-color: #e8c46a; background: rgba(232, 196, 106, 0.14); }
  .actions { display: grid; gap: 8px; }
  .primary, .secondary { padding: 12px 16px; border-radius: 12px; font: inherit; font-weight: 700; font-size: 1.05rem; cursor: pointer; }
  .primary { border: 0; background: #e8c46a; color: #1d1a16; }
  .secondary { border: 2px solid #e8c46a; background: transparent; color: #fbf6ec; }
  /* The colour is also inline on the link: a page's own link colour outranks a component's layered styles. */
  .link { color: #e8c46a; font-size: 0.9rem; text-align: center; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: rgba(0, 0, 0, 0.3); font-weight: 700; }
  .bar button { background: none; border: 0; color: #e8c46a; font: inherit; cursor: pointer; }
  iframe { display: block; width: 100%; height: min(78vh, 760px); border: 0; background: #1f4d3a; }
  .primary:focus-visible, .secondary:focus-visible, .tabs button:focus-visible, .bar button:focus-visible { outline: 3px solid #fbf6ec; outline-offset: 2px; }
  .missing { padding: 16px; color: #ffb4a8; }
</style>
<card-room server game="" challenge="" who="">
  <div class="box">
    <p zb-if={!base} class="missing">This card room needs its address: add server="https://…" to the tag.</p>
    <div zb-else-if={playing}>
      <div class="bar">
        <span>{info().emoji} {info().name}</span>
        <button type="button" onclick={() => { playing = false }}>Close the game</button>
      </div>
      <iframe src={frameSrc()} title={`${info().name} against the computer`} allow="autoplay; vibrate" sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms allow-modals"></iframe>
    </div>
    <div zb-else class="card">
      <div zb-if={offered.length > 1} class="tabs" role="group" aria-label="Game">
        <zb-each items={offered} as="g" key={g}>
          <button type="button" aria-pressed={picked === g ? "true" : "false"} onclick={() => { picked = g }}>{GAMES[g].emoji} {GAMES[g].name}</button>
        </zb-each>
      </div>
      <h3><span aria-hidden="true">{info().emoji}</span> Play {info().name}</h3>
      <p>{info().blurb}</p>
      <div class="actions">
        <button type="button" class="primary" onclick={() => { playing = true }}>Play here against the computer</button>
        <button zb-if={challenge} type="button" class="secondary" onclick={() => openTab({ challenge, game: picked })}>Challenge {who || "me"} to {info().name}</button>
        <a class="link" style="color: #e8c46a" href={url({ game: picked })} target="_blank" rel="noopener">Open the card room for family tables ↗</a>
      </div>
    </div>
  </div>
</card-room>
