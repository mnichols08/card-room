{
  "name": "@cardroom/conformance",
  "version": "0.1.0",
  "private": true,
  "description": "One fixture of Zubra components, written in every framework the card room uses, and one set of browser tests run against them all.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:angular",
    "build:angular": "zubra build --lib ../ui/src --out angular/zubra --name @cardroom/conformance-zubra && ng build --project conformance",
    "conformance": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@zubra/runtime": "^5.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.0",
    "solid-js": "^1.9.19",
    "svelte": "^5.57.0",
    "tslib": "^2.8.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@zubra/compiler": "^5.9.2",
    "@zubra/unplugin": "^5.9.2",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
