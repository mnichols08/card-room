{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": { "@spades/ui/*": ["../ui/src/*"] }
  },
  "include": ["src/shared", "src/element", "src/react", "src/zb.d.ts", "tests", "playwright.config.ts", "vite.config.ts"]
}
