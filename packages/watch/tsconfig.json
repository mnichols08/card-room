{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node",
      "@zubra/unplugin/client"
    ],
    "paths": {
      "@spades/ui/*": [
        "./.zubra/types/__/ui/src/*",
        "../ui/src/*"
      ]
    },
    "allowArbitraryExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
