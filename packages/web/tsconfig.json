{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "paths": {
      "@spades/rules": [
        "../rules/src/index.ts"
      ],
      "@cardroom/games": [
        "../games/src/index.ts"
      ],
      "@cardroom/physics": [
        "../physics/src/index.ts"
      ],
      "@spades/ui/*": [
        "./.zubra/types/__/ui/src/*",
        "../ui/src/*"
      ],
      "@spades/rooms/*": [
        "../rooms/src/*"
      ],
      "@cardroom/decks": [
        "../decks/src/index.ts"
      ]
    },
    "types": [
      "@zubra/unplugin/client",
      "node"
    ],
    "allowArbitraryExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
